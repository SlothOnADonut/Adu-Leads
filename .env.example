# ------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# In Vercel, add the same keys under Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The "service_role" / "secret" key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The address printed in each QR code. Each lead gets ?lead=ANA-0001 added.
# Option A (simplest): this app's own landing page, e.g. https://leads.armandofundsloans.com/adu
# Option B: Armando's main website, e.g. https://armandofundsloans.com/adu
#           (that site must call this app's /api/track — see README)
NEXT_PUBLIC_TRACKING_BASE_URL=https://armandofundsloans.com/adu

# Landing page buttons (leave blank to fall back to the phone number)
NEXT_PUBLIC_HELOC_URL=
NEXT_PUBLIC_BOOKING_URL=

# Only needed for Option B: comma-separated sites allowed to POST to /api/track
TRACKING_ALLOWED_ORIGINS=https://armandofundsloans.com,https://www.armandofundsloans.com
